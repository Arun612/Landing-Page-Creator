# ╔══════════════════════════════════════════════════════════════════╗
# ║  Landing Page Generator — Environment Configuration             ║
# ║  Copy this file to .env and fill in your actual credentials.    ║
# ║  NEVER commit the .env file to version control.                 ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── Azure OpenAI (GPT) ─────────────────────────────────────────
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ─── Azure OpenAI (DALL-E 3) ────────────────────────────────────
# Leave blank to disable DALL-E image generation.
DALLE_API_KEY=your-dalle-api-key-here
DALLE_ENDPOINT=https://your-resource.openai.azure.com/
DALLE_DEPLOYMENT_NAME=dall-e-3
DALLE_API_VERSION=2024-02-01

# ─── Pixabay (Stock Photos) ─────────────────────────────────────
# Get a free key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=your-pixabay-api-key-here
